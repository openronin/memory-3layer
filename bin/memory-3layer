#!/usr/bin/env bash
# memory-3layer — agent memory that belongs to no harness.
#
# Data lives outside any harness directory, keyed by the project's git remote, so
# the same project resolves to the same memory on any machine and in any agent.
# A harness's own memory stays its own business: this tool never reads, writes or
# configures it.
#
#   $MEMORY_3LAYER_HOME       default ~/.local/share/memory-3layer
#   $MEMORY_3LAYER_SECRETS    default ~/.local/share/memory-3layer-secrets (never synced)
#   $MEMORY_3LAYER_CONFIG     default ~/.config/memory-3layer/config
#   $MEMORY_3LAYER_KEY        the project, wherever a command runs (else pin, git remote, path)

set -u

SELF_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_FILE="${MEMORY_3LAYER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/memory-3layer/config}"

L2_SOFT_BYTES=40000
L2_HARD_BYTES=80000
_env_home="${MEMORY_3LAYER_HOME:-}"
# shellcheck disable=SC1090
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE" 2>/dev/null
# The environment beats the config file, the config file beats the default.
HOME_DIR="${_env_home:-${MEMORY_3LAYER_HOME:-$DATA_ROOT/memory-3layer}}"
SECRETS_DIR="${MEMORY_3LAYER_SECRETS:-$DATA_ROOT/memory-3layer-secrets}"

UNASSIGNED=_unassigned
PIN_FILE=.memory-3layer-key
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/memory-3layer"

die() { printf 'memory-3layer: %s\n' "$*" >&2; exit 2; }

bash4() {
  # A bash 4 or newer: macOS ships 3.2, and a hook's PATH may not reach Homebrew's.
  local b
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$b" ]] && "$b" -c '(( BASH_VERSINFO[0] >= 4 ))' 2>/dev/null && { printf '%s' "$b"; return 0; }
  done
  return 1
}

to_epoch() {
  # ISO-8601 to seconds, or nothing. BSD date has no -d. It doesn't read an offset either,
  # so the marker is taken as UTC there, and that is what the protocol writes.
  local iso=$1 plain
  date -d "$iso" +%s 2>/dev/null && return 0
  plain=${iso%Z}; plain=${plain%%.*}; plain=${plain%%+*}
  date -j -u -f '%Y-%m-%dT%H:%M:%S' "$plain" +%s 2>/dev/null
}

normalize_remote() {
  # Accepts https, scp-like and ssh remotes, with or without credentials or a port.
  local u=$1 host rest
  u=${u%/}; u=${u%.git}; u=${u%.GIT}
  if [[ "$u" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*://(.*)$ ]]; then
    u=${BASH_REMATCH[1]}; u=${u#*@}
    host=${u%%/*}; rest=${u#*/}; host=${host%%:*}
  elif [[ "$u" =~ ^([^/:]+):(.+)$ ]]; then
    host=${BASH_REMATCH[1]}; rest=${BASH_REMATCH[2]}; host=${host#*@}
  else
    return 1
  fi
  [[ -n "$host" && -n "$rest" && "$rest" != "$host" ]] || return 1
  rest=${rest#/}
  printf '%s/%s' "$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')" "$rest"
}

valid_key() {
  [[ "$1" =~ ^[A-Za-z0-9._/-]+$ && "$1" != "$UNASSIGNED"* && "$1" != /* && "$1" != */ ]] || return 1
  case "/$1/" in */../*|*/./*|*//*) return 1 ;; esac
}

read_pin() {
  # Print a valid key from a marker file. A broken marker counts as no marker, so the
  # project falls back to its remote or path instead of failing.
  local f=$1/$PIN_FILE key
  [[ -f "$f" ]] || return 1
  IFS= read -r key < "$f" || [[ -n "$key" ]] || return 1
  key=${key%$'\r'}
  valid_key "$key" || { printf 'memory-3layer: ignoring invalid key in %s\n' "$f" >&2; return 1; }
  printf '%s' "$key"
}

pinned_key() {
  # The marker is untracked, so a worktree doesn't have it: look in the main checkout
  # too. Outside git, walk up to $HOME so subdirectories share their project's key.
  local root=$1 is_git=$2 common up
  read_pin "$root" && return 0
  if [[ "$is_git" == 1 ]]; then
    common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
    [[ "${common##*/}" == .git ]] && read_pin "${common%/.git}" && return 0
    return 1
  fi
  up=$root
  while [[ "$up" != "$HOME" && "$up" != / && -n "$up" ]]; do
    up=${up%/*}; [[ -n "$up" ]] || up=/
    read_pin "$up" && return 0
  done
  return 1
}

follow_redirect() {
  # After a rekey, every machine still on the old remote must reach the new data.
  local key=$1 next i
  for i in 1 2 3 4 5; do
    next=$(alias_for "$key") || break
    key=$next
  done
  printf '%s' "$key"
}

project_root() {
  local dir=${1:-$PWD}
  git -C "$dir" rev-parse --show-toplevel 2>/dev/null || (cd "$dir" 2>/dev/null && pwd) || die "no such directory: $dir"
}

project_key() {
  # In order: a pinned key, the git remote, the path under $HOME. Each step falls back
  # to the next. A worktree and any subdirectory get the same key as the main checkout.
  local dir=${1:-$PWD} root url key is_git=0
  # Set by hand, it names the project wherever the command runs: for a directory with
  # no git and no pin, or a command run from somewhere else.
  if [[ -n "${MEMORY_3LAYER_KEY:-}" ]]; then
    valid_key "$MEMORY_3LAYER_KEY" || die "bad key in MEMORY_3LAYER_KEY: '$MEMORY_3LAYER_KEY'"
    follow_redirect "$MEMORY_3LAYER_KEY"; return
  fi
  git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 && is_git=1
  root=$(project_root "$dir")
  if key=$(pinned_key "$root" "$is_git"); then
    printf '%s' "$key"; return 0
  fi
  url=$(git -C "$root" remote get-url origin 2>/dev/null) || url=""
  if [[ -n "$url" ]] && key=$(normalize_remote "$url"); then
    :
  else
    # git prints a physical path, and $HOME may go through a symlink.
    key=${root#"$HOME"/}
    [[ "$key" != "$root" ]] || key=${root#"$(cd "$HOME" 2>/dev/null && pwd -P)"/}
    key="local/$key"; key=${key//\/\//\/}
  fi
  case "/$key/" in */../*|*/./*) die "unsafe project key: $key" ;; esac
  follow_redirect "$key"
}

project_dir() { printf '%s/projects/%s' "$HOME_DIR" "$(project_key "${1:-$PWD}")"; }
identity_file() { printf '%s/identity/IDENTITY.md' "$HOME_DIR"; }

json_escape() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

session_notes() {
  # Staleness and size warnings for the SESSION.md at $1.
  local f=$1 stamp epoch age bytes
  [[ -f "$f" ]] || return 0
  stamp=$(grep -oE 'last_updated:[[:space:]]*[0-9T:.Z+-]+' "$f" | head -n1 | sed 's/last_updated:[[:space:]]*//')
  if [[ -z "$stamp" ]]; then
    printf '\n\nNOTE: SESSION.md has no last_updated marker, so it may be out of date. Confirm the goal with the user before work that relies on it.'
  else
    epoch=$(to_epoch "$stamp" || echo 0)
    age=$(( $(date +%s) - epoch ))
    if [[ $epoch -gt 0 && $age -gt 86400 ]]; then
      printf "\n\nSTALE: SESSION.md was last updated %dd %dh ago and may describe another task. Before work that relies on it or writes to it, quote its goal to the user and ask whether to continue or reset. Answer a question that does not depend on it without asking." $((age / 86400)) $(((age % 86400) / 3600))
    fi
  fi
  bytes=$(wc -c < "$f" | tr -d ' ')
  if [[ "${L2_HARD_BYTES:-0}" -gt 0 && "$bytes" -ge "${L2_HARD_BYTES:-0}" ]]; then
    printf '\n\nL2 HARD LIMIT: SESSION.md is %d KB. Before other work, move closed arcs to the archive with /memory rotate. Never cut active state.' $((bytes / 1000))
  elif [[ "${L2_SOFT_BYTES:-0}" -gt 0 && "$bytes" -ge "${L2_SOFT_BYTES:-0}" ]]; then
    printf '\n\nL2 SOFT LIMIT: SESSION.md is %d KB. At the next pause, move closed arcs to the archive.' $((bytes / 1000))
  fi
}

sync_notes() {
  # What an agent must know about sync: a storage that is down, a conflict to merge.
  local pd=$1 f st addr rest
  if (( BASH_VERSINFO[0] < 4 )) && [[ -f "$(dirname "$CONFIG_FILE")/storage.conf" ]] && ! bash4 >/dev/null; then
    printf '\n\nSYNC: not running, it needs bash 4 or newer and this is %s. Tell the user: brew install bash' "$BASH_VERSION"
  fi
  for f in "$STATE_DIR"/stores/*.state; do
    [[ -f "$f" ]] || continue
    IFS=$'\t' read -r st _ addr rest < "$f"
    [[ "$st" == fail ]] && printf '\n\nSYNC: storage %s: %s, so this may not be the latest data from other machines. Tell the user; memory-3layer sync check explains the fix.' "$addr" "$rest"
  done
  local key k here there
  key=$(project_key 2>/dev/null) || key=""
  if [[ -n "$key" ]]; then
    while IFS=$'\t' read -r k here there; do
      [[ "$k" == "$key" ]] || continue
      printf '\n\nSYNC ROUTE: storage %s holds memory of this project, but this machine routes it to %s: what is there is not laid out here, and changes don'"'"'t reach it. Tell the user: usually storage.conf on this machine lacks a [project %s] rule (memory-3layer sync route %s). After a deliberate move, the old copy can be removed from that storage by hand.' "$here" "$there" "$key" "$key"
    done < <(cat "$STATE_DIR"/stores/*.elsewhere 2>/dev/null)
  fi
  if compgen -G "$pd/superseded/conflict-*/*" >/dev/null; then
    printf '\n\nSYNC CONFLICT: another version of a file from a different machine is in %s/superseded/conflict-*/. Compare it with the current file, merge what matters with the user, then delete it.' "$pd"
  fi
}

take_arrived() {
  # Tasks sync brought from another machine for this project, one line each, then dropped:
  # only one session hears of them. The other projects' lines stay for their sessions.
  local f="$STATE_DIR/arrived" tmp key
  [[ -s "$f" ]] || return 0
  key=$(project_key 2>/dev/null) || return 0
  tmp="$f.$$"
  mv -f "$f" "$tmp" 2>/dev/null || return 0
  awk -F'\t' -v k="$key" '$1 != k' "$tmp" >> "$f"
  awk -F'\t' -v k="$key" '$1 == k {
      if (!($2 in kind)) order[++n] = $2
      if ($3 == "closed" || !($2 in kind) || kind[$2] != "new") kind[$2] = $3
    }
    END { for (i = 1; i <= n; i++) print order[i] " (" kind[order[i]] ")" }' "$tmp"
  rm -f "$tmp"
}

task_nudge() {
  # task_nudge <session> — said once, to a session that is on its TASK_NUDGE_TURNS-th
  # request and has written to no task. Sessions were seen to make server changes over
  # five requests and a compaction and leave nothing in memory. The count is of finished
  # turns, kept by the Stop hook; a session bound to a task has a binding file.
  local turns="${TASK_NUDGE_TURNS:-3}" f="$STATE_DIR/turns/$1" n pd active
  [[ "$turns" -gt 0 && -n "$1" && -f "$f" && ! -f "$STATE_DIR/bindings/$1" ]] || return 1
  n=$(cat "$f"); [[ "$n" =~ ^[0-9]+$ && "$n" -ge $((turns - 1)) ]] || return 1
  pd=$(project_dir 2>/dev/null) || return 1
  [[ -f "$pd/CORE.md" || -d "$pd/_tasks" ]] || return 1
  echo told > "$f"
  active=$(ls "$pd/_tasks" 2>/dev/null | sed -n 's/\.md$//p' | paste -sd, - | sed 's/,/, /g')
  printf 'NO TASK YET: this session is on request %d and has written to no task. Work finished and committed within the session needs none. Work with steps still ahead, or that changes anything outside the repository (a server, an external service, an account), is a task: record it now with memory-3layer task open <name>%s.' \
    $((n + 1)) "${active:+, or task log if it belongs to an open one ($active)}"
}

core_changed() {
  # CORE.md of this project is newer than the copy the last log record was made from.
  # Runs on every tool call, so it only compares two times.
  local core snap
  core="$(project_dir)/CORE.md"; [[ -f "$core" ]] || return 1
  snap="$STATE_DIR/core/$(project_key | cksum | cut -d' ' -f1)"
  [[ ! -f "$snap" || "$core" -nt "$snap" ]]
}

cmd_tick_notes() {
  # After a tick: on Stop count the turn; on PostToolUse tell the agent about tasks that
  # came in with a sync, and once about a session that works without a task.
  local input="" list event="" sid="" out="" f
  [[ -t 0 ]] || IFS= read -r -d '' -t 1 input || true
  [[ "$input" =~ \"hook_event_name\"[[:space:]]*:[[:space:]]*\"([A-Za-z]+)\" ]] && event=${BASH_REMATCH[1]}
  [[ "$input" =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([A-Za-z0-9_-]+)\" ]] && sid=${BASH_REMATCH[1]}
  if [[ "$event" == Stop && -n "$sid" && ! -f "$STATE_DIR/bindings/$sid" ]]; then
    f="$STATE_DIR/turns/$sid"; mkdir -p "$STATE_DIR/turns"
    [[ "$(cat "$f" 2>/dev/null)" == told ]] || echo $(( $(cat "$f" 2>/dev/null || echo 0) + 1 )) > "$f"
    find "$STATE_DIR/turns" -type f -mtime +30 -delete 2>/dev/null
    return 0
  fi
  [[ "$event" == PostToolUse ]] || return 0
  f="$STATE_DIR/notices/$(project_key | cksum | cut -d' ' -f1)"
  if [[ -s "$f" ]]; then out=$(paste -sd' ' "$f"); rm -f "$f"; fi
  list=$(take_arrived | paste -sd, - | sed 's/,/, /g')
  [[ -z "$list" ]] || out="${out:+$out }TASKS CHANGED ON ANOTHER MACHINE, brought by sync just now: $list. The task index from the session start doesn't have this. Before continuing one of them, or if it bears on the current work, read it with memory-3layer task show <name>."
  list=$(task_nudge "$sid") && out="${out:+$out }$list"
  [[ -n "$out" ]] || return 0
  printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"%s"}}\n' "$(json_escape "$out")"
}

bound_elsewhere() {
  # bound_elsewhere <task> — the project this session is bound to, when the task is
  # active there and not in the project of the current directory. An agent that has
  # stepped into a scratch directory still means the task it works on.
  local s="${CLAUDE_CODE_SESSION_ID:-}" k t
  [[ -n "$1" && "$s" =~ ^[A-Za-z0-9_-]+$ && -f "$STATE_DIR/bindings/$s" ]] || return 1
  IFS=$'\t' read -r k t < "$STATE_DIR/bindings/$s"
  [[ "$t" == "$1" && -f "$HOME_DIR/projects/$k/_tasks/$1.md" ]] || return 1
  [[ ! -f "$(project_dir)/_tasks/$1.md" ]] || return 1
  printf '%s' "$k"
}

tasks() {
  local k
  if [[ -z "${MEMORY_3LAYER_KEY:-}" && "${1:-}" == task ]]; then
    case "${2:-}" in log|show|files|close)
      if k=$(bound_elsewhere "${3:-}"); then
        printf '(%s: taken from %s, the project this session works on, not from this directory)\n' "$3" "$k" >&2
        local -x MEMORY_3LAYER_KEY="$k"
      fi ;;
    esac
  fi
  # The index also counts what other members of a shared hub have open in this project.
  local members=""
  case "${1:-}" in state|context)
    members=$(MEMORY_3LAYER_HOME="$HOME_DIR" MEMORY_3LAYER_STATE="$STATE_DIR" MEMORY_3LAYER_CONFIG_DIR="$(dirname "$CONFIG_FILE")" MEMORY_3LAYER_SECRETS="$SECRETS_DIR" \
      bash "$SELF_DIR/memory-sync.sh" members "$(project_key)" 2>/dev/null </dev/null) ;;
  esac
  # A record carries the code revision it was written at, when this directory is the
  # project's repository and not a place the session stepped into.
  local rev="" h b
  if [[ -z "${MEMORY_3LAYER_KEY:-}" ]] && h=$(git rev-parse --short HEAD 2>/dev/null); then
    git diff-index --quiet HEAD -- 2>/dev/null || h+=+
    rev="r:$h"
    b=$(git symbolic-ref -q --short HEAD 2>/dev/null) && [[ "$b" != *[[:space:]]* ]] && rev+=" b:$b"
  fi
  MEMORY_3LAYER_HOME="$HOME_DIR" MEMORY_3LAYER_SECRETS="$SECRETS_DIR" MEMORY_3LAYER_STATE="$STATE_DIR" \
    MEMORY_3LAYER_PROJECT="$(project_dir)" MEMORY_3LAYER_KEY="$(project_key)" MEMORY_3LAYER_REV="$rev" MEMORY_3LAYER_MEMBERS="$members" \
    TASK_STALE_DAYS="${TASK_STALE_DAYS:-7}" CORE_BRIEF_BYTES="${CORE_BRIEF_BYTES:-5000}" \
    CORE_SOFT_BYTES="${CORE_SOFT_BYTES:-40000}" CORE_HARD_BYTES="${CORE_HARD_BYTES:-80000}" \
    bash "$SELF_DIR/memory-tasks.sh" "$@"
}

context_core() {
  # A project on task journals: everything that matters is in the text itself, because
  # a request to read a file can be skipped and injected context can't.
  local pd=$1 id=$2 session=$3
  cat <<TEXT
MEMORY-3LAYER ACTIVE. Anything that must survive a new machine or a different agent goes here, not into this harness's own memory, if it has one.

Project: $(project_key)
TEXT
  tasks ${session:+--session "$session"} context
  if [[ -f "$id" ]]; then printf '\nIdentity (%s):\n' "$id"; cat "$id"; fi
  [[ -f "$pd/project.md" ]] && printf '\nProject notes: %s. Read them before your first response.\n' "$pd/project.md"
  cat <<TEXT

Client: $SELF_DIR/memory-3layer. Rules: the protocol skill, or the repo entry (CLAUDE.md / AGENTS.md).

Work with more than one step, or that can outlive this session, is a task. Work finished and committed within the session needs none; a change outside the repository (a server, an external service, an account) always is one:
  memory-3layer task open <name> | task show <name> [--log|--brief] | task list
  memory-3layer task log <name> note|decision|next|blocker|checkpoint | task files <name> | task close <name>
The text goes on stdin as a quoted heredoc. In echo "..." the shell runs \`...\` and expands \$, and the record is saved changed:
  memory-3layer task log <name> note <<'EOF'
  <text>
  EOF
Journals are written only through these commands. Keep next current as you work: note is what was done and learned, decision is a choice and why, next is only the step ahead (the index shows its start). When told a checkpoint is due, write it: the state of the whole task, which then stands for the older records in task show. Files a task needs beyond this session go in the directory task files prints. A task whose work is done is closed, after what must outlive it has moved into CORE.md.
$pd/CORE.md is yours to edit freely: live extracts worth keeping, with the most important in its # Brief block. Before closing a task, move what must outlive it there. Never write a secret value into memory; write secret://<name>.
TEXT
  if compgen -G "$pd/imported/*/*.md" >/dev/null; then
    printf '\nNotes imported from a harness are in %s/imported/. They are not reviewed: read them when relevant, verify them, and propose moving what still holds into project.md or the repo docs.\n' "$pd"
  fi
  sync_notes "$pd"
}

context_text() {
  local pd id session=${1:-}
  pd=$(project_dir); id=$(identity_file)
  if [[ -f "$pd/CORE.md" || -d "$pd/_tasks" ]]; then
    context_core "$pd" "$id" "$session"
    return
  fi
  cat <<TEXT
MEMORY-3LAYER ACTIVE. Anything that must survive a new machine or a different agent goes here, not into this harness's own memory, if it has one.

Before your first response, read if they exist:
1. $id
2. $pd/SESSION.md (working state, treat as authoritative)
3. $pd/project.md

Client: $SELF_DIR/memory-3layer. Rules for where a fact belongs: the memory protocol, in CLAUDE.md or the protocol skill.

Keep SESSION.md current as you work: decisions with rationale, last action, next step, and a fresh last_updated. Never write a secret value into memory; write secret://<name>.
TEXT
  if compgen -G "$pd/imported/*/*.md" >/dev/null; then
    printf '\nNotes imported from a harness are in %s/imported/. They are not reviewed: read them when relevant, verify them, and propose moving what still holds into project.md or the repo docs.\n' "$pd"
  fi
  session_notes "$pd/SESSION.md"
  sync_notes "$pd"
}

cmd_context() {
  # With --hook-format, or JSON naming a hook event on stdin, answer as a hook.
  local format=text event=SessionStart input="" session=""
  [[ "${1:-}" == --hook-format ]] && format=${2:-text}
  if [[ ! -t 0 ]]; then
    IFS= read -r -d '' -t 1 input || true
    if [[ "$input" =~ \"hook_event_name\"[[:space:]]*:[[:space:]]*\"([A-Za-z]+)\" ]]; then
      event=${BASH_REMATCH[1]}; [[ "$format" == text ]] && format=hook
    fi
    [[ "$input" =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([A-Za-z0-9_-]+)\" ]] && session=${BASH_REMATCH[1]}
  fi
  local text; text=$(context_text "$session")
  # The task index in this context is current, so what sync brought earlier is in it.
  take_arrived >/dev/null
  if [[ "$format" == hook ]]; then
    printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$event" "$(json_escape "$text")"
  else
    printf '%s\n' "$text"
  fi
}

cmd_import() {
  # import <harness> [--apply]: copy a harness's own memory into imported/<harness>/.
  # Shows the plan by default. The source is never changed, a file with a secret is
  # never copied, and the copy is a mirror: promoting a fact is a separate decision.
  local harness=${1:-} apply=0 adapter root
  [[ -n "$harness" ]] || die "usage: import <harness> [--apply]"
  [[ "${2:-}" == --apply ]] && apply=1
  [[ "$harness" =~ ^[a-z0-9-]+$ ]] || die "bad harness name '$harness'"
  root=$(cd "$SELF_DIR/.." && pwd)
  adapter="$root/harness/$harness/import-memory"
  [[ -x "$adapter" ]] || die "no importer for '$harness' (looked for $adapter)"
  local rows; rows=$("$adapter") || die "the $harness importer failed"
  local dir label kind file key dest new=0 changed=0 same=0 secret=0 unknown=0
  while IFS=$'\t' read -r dir label kind file; do
    [[ -n "$file" ]] || continue
    if ! bash "$SELF_DIR/memory-secrets.sh" scan "$file" >/dev/null; then
      printf 'SECRET, skipped  %s\n' "$file"; secret=$((secret + 1)); continue
    fi
    if [[ "$dir" == - ]]; then
      # Kept rather than dropped: a person can assign these later.
      if key=$(alias_for "$label"); then :; else
        key="$UNASSIGNED/$label"; [[ -f "$HOME_DIR/projects/$key/imported/$harness/${file##*/}" ]] || unknown=$((unknown + 1))
      fi
    else
      key=$(project_key "$dir")
    fi
    dest="$HOME_DIR/projects/$key/imported/$harness/${file##*/}"
    if [[ -f "$dest" ]] && cmp -s "$file" "$dest"; then
      same=$((same + 1)); continue
    fi
    if [[ -f "$dest" ]]; then
      printf 'update           %s/%s\n' "$key" "${file##*/}"; changed=$((changed + 1))
    else
      printf 'new %-12s %s/%s\n' "$kind" "$key" "${file##*/}"; new=$((new + 1))
    fi
    if [[ $apply -eq 1 ]]; then
      mkdir -p "${dest%/*}" && cp "$file" "$dest" || die "cannot write $dest"
    fi
  done <<< "$rows"
  printf '\n%s: %d new, %d updated, %d already imported, %d with secrets, %d without a known project\n' "$harness" "$new" "$changed" "$same" "$secret" "$unknown"
  [[ $apply -eq 1 ]] || printf 'Nothing was changed. Add --apply to copy.\n'
}

cmd_install_cli() {
  # install-cli [dir]: make `memory-3layer` work in a terminal, not only inside the agent.
  # A plugin gets the shim, which follows whichever plugin is enabled and its updates;
  # a manual install links the client itself.
  local dir=${1:-$HOME/.local/bin} shim="$SELF_DIR/claude-plugin-shim" f
  mkdir -p "$dir" || die "cannot create $dir"
  f="$dir/memory-3layer"
  if [[ -e "$f" && ! -L "$f" ]]; then
    mv "$f" "$f.bak-$(date +%Y%m%d%H%M%S)" && printf 'kept the old %s as .bak\n' "$f"
  fi
  if [[ -f "$shim" ]] && command -v python3 >/dev/null; then
    if [[ -f "$dir/claude-plugin-shim" ]] && ! cmp -s "$shim" "$dir/claude-plugin-shim"; then
      cp -p "$dir/claude-plugin-shim" "$dir/claude-plugin-shim.bak-$(date +%Y%m%d%H%M%S)"
    fi
    cp "$shim" "$dir/claude-plugin-shim.$$" && chmod 755 "$dir/claude-plugin-shim.$$" && mv -f "$dir/claude-plugin-shim.$$" "$dir/claude-plugin-shim"
    ln -sfn claude-plugin-shim "$f"
    if "$f" key / >/dev/null 2>&1; then
      printf '%s -> claude-plugin-shim: runs the enabled memory-3layer plugin\n' "$f"
    else
      ln -sfn "$SELF_DIR/memory-3layer" "$f"
      printf '%s -> %s: no enabled plugin found, linked this client\n' "$f" "$SELF_DIR/memory-3layer"
    fi
  else
    ln -sfn "$SELF_DIR/memory-3layer" "$f"
    printf '%s -> %s\n' "$f" "$SELF_DIR/memory-3layer"
  fi
  case ":$PATH:" in *":$dir:"*) ;; *) printf '%s is not on PATH: add it in your shell profile\n' "$dir" ;; esac
}

cmd_migrate() {
  # migrate <harness> [--apply]: copy data of an older version out of a harness's
  # directory. The source is never changed, and this is safe to repeat until the
  # switch: a destination that is newer than its source is left alone. When several
  # old folders map to one project, the newest file takes the name and a different
  # older one is kept under superseded/<old folder>/.
  local harness=${1:-} apply=0 adapter rows
  [[ -n "$harness" ]] || die "usage: migrate <harness> [--apply]"
  [[ "${2:-}" == --apply ]] && apply=1
  [[ "$harness" =~ ^[a-z0-9-]+$ ]] || die "bad harness name '$harness'"
  adapter="$(cd "$SELF_DIR/.." && pwd)/harness/$harness/import-memory"
  [[ -x "$adapter" ]] || die "no adapter for '$harness'"
  rows=$("$adapter" --legacy) || die "the $harness adapter failed"
  local stamp dir label kind file key dest name copied=0 same=0 kept=0 dup=0 old=0 secret=0 unknown=0
  local -A winner=()
  while IFS=$'\t' read -r stamp dir label kind file; do
    [[ -n "$file" ]] || continue
    name=${file##*/}
    case "$kind" in
      identity) dest=$(identity_file) ;;
      config) dest=$CONFIG_FILE ;;
      *)
        if [[ "$dir" == - ]]; then
          if key=$(alias_for "$label"); then :; else
            key="$UNASSIGNED/$label"; unknown=$((unknown + 1))
          fi
        else
          key=$(project_key "$dir")
        fi
        dest="$HOME_DIR/projects/$key/$name" ;;
    esac
    if ! bash "$SELF_DIR/memory-secrets.sh" scan "$file" >/dev/null; then
      [[ "$kind" == config ]] || { printf 'SECRET, skipped  %s\n' "$file"; secret=$((secret + 1)); continue; }
    fi
    if [[ -n "${winner[$dest]:-}" ]]; then
      if cmp -s "$file" "${winner[$dest]}"; then
        dup=$((dup + 1)); printf 'duplicate        %s (same as the newer copy)\n' "$file"; continue
      fi
      dest="${dest%/*}/superseded/$label/$name"; old=$((old + 1))
      printf 'older variant    %s -> %s\n' "$file" "${dest#"$HOME_DIR"/}"
    else
      winner[$dest]=$file
    fi
    if [[ -f "$dest" ]] && cmp -s "$file" "$dest"; then
      same=$((same + 1)); continue
    fi
    if [[ -f "$dest" && "$dest" -nt "$file" ]]; then
      printf 'kept newer       %s\n' "$dest"; kept=$((kept + 1)); continue
    fi
    copied=$((copied + 1))
    if [[ $apply -eq 1 ]]; then
      mkdir -p "${dest%/*}" && cp -p "$file" "$dest" || die "cannot write $dest"
    fi
  done < <(while IFS=$'\t' read -r dir label kind file; do
      [[ -n "$file" ]] && printf '%s\t%s\t%s\t%s\t%s\n' "$(stat -c %Y "$file" 2>/dev/null || stat -f %m "$file")" "$dir" "$label" "$kind" "$file"
    done <<< "$rows" | sort -rn)
  printf '\n%s: %d to copy, %d already there, %d kept newer, %d duplicates, %d older variants, %d with secrets, %d files in %s\n' "$harness" "$copied" "$same" "$kept" "$dup" "$old" "$secret" "$unknown" "projects/$UNASSIGNED"
  [[ $apply -eq 1 ]] || printf 'Nothing was changed. Add --apply to copy.\n'
}

alias_for() {
  # The key a person assigned to an old folder, if any.
  [[ -f "$HOME_DIR/aliases.tsv" ]] || return 1
  awk -F'\t' -v l="$1" '$1 == l { k = $2 } END { if (k == "") exit 1; print k }' "$HOME_DIR/aliases.tsv"
}

move_tree() {
  # Move <src> into <dest dir>. Nothing is lost: an identical file is dropped, a
  # different one is kept under superseded/<label>/.
  local src=$1 target=$2 label=$3 f rel dest moved=0 dup=0 old=0
  if [[ -d "$src" ]]; then
    while IFS= read -r f; do
      rel=${f#"$src"/}
      dest="$target/$rel"
      if [[ -f "$dest" ]]; then
        if cmp -s "$f" "$dest"; then rm "$f"; dup=$((dup + 1)); continue; fi
        dest="$target/superseded/$label/$rel"; old=$((old + 1))
      else
        moved=$((moved + 1))
      fi
      mkdir -p "${dest%/*}" && mv "$f" "$dest" || die "cannot move $f"
    done < <(find "$src" -type f)
    find "$src" -depth -type d -empty -delete
  fi
  printf '%d moved, %d identical dropped, %d kept under superseded/' "$moved" "$dup" "$old"
}

remember_alias() {
  mkdir -p "$HOME_DIR"
  alias_for "$1" >/dev/null || printf '%s\t%s\n' "$1" "$2" >> "$HOME_DIR/aliases.tsv"
}

cmd_assign() {
  # assign <old folder> <key>: give an unattributed folder its project, and remember
  # that so a repeated migrate or import follows it.
  [[ $# -eq 2 ]] || die "usage: assign <old folder> <key>"
  local label=$1 key=$2 res
  [[ "$label" =~ ^[A-Za-z0-9._-]+$ ]] || die "bad folder name '$label'"
  valid_key "$key" || die "bad key '$key'"
  remember_alias "$label" "$key"
  res=$(move_tree "$HOME_DIR/projects/$UNASSIGNED/$label" "$HOME_DIR/projects/$key" "$label")
  printf '%s -> %s: %s\n' "$label" "$key" "$res"
}

cmd_rekey() {
  # rekey <old key> <new key>: move a project's memory after its remote changed. The
  # old key redirects to the new one, for machines that still use the old remote.
  [[ $# -eq 2 ]] || die "usage: rekey <old key> <new key>"
  local old=$1 new=$2 res
  valid_key "$old" || die "bad key '$old'"
  valid_key "$new" || die "bad key '$new'"
  [[ "$old" != "$new" ]] || die "the keys are the same"
  [[ "$(follow_redirect "$new")" != "$old" ]] || die "'$new' already redirects to '$old'"
  remember_alias "$old" "$new"
  res=$(move_tree "$HOME_DIR/projects/$old" "$HOME_DIR/projects/$new" "${old//\//_}")
  printf '%s -> %s: %s\n' "$old" "$new" "$res"
}

cmd_pin() {
  # pin <key> [dir]: fix this project's key. It takes the existing memory along, and
  # stays out of the repo's history through .git/info/exclude.
  [[ $# -ge 1 ]] || die "usage: pin <key> [dir]"
  local key=$1 dir=${2:-$PWD} root old exclude res
  valid_key "$key" || die "bad key '$key'"
  root=$(project_root "$dir")
  old=$(project_key "$root")
  printf '%s\n' "$key" > "$root/$PIN_FILE" || die "cannot write $root/$PIN_FILE"
  if exclude=$(git -C "$root" rev-parse --path-format=absolute --git-path info/exclude 2>/dev/null); then
    mkdir -p "${exclude%/*}"
    grep -qxF "$PIN_FILE" "$exclude" 2>/dev/null || printf '%s\n' "$PIN_FILE" >> "$exclude"
  fi
  res="nothing to move"
  if [[ "$old" != "$key" && -d "$HOME_DIR/projects/$old" ]]; then
    res=$(move_tree "$HOME_DIR/projects/$old" "$HOME_DIR/projects/$key" "${old//\//_}")
  fi
  printf 'pinned %s to %s: %s\n' "$root" "$key" "$res"
}

cmd_unpin() {
  # unpin [dir]: remove the marker. The key falls back to the remote or the path, and
  # the memory stays under the pinned key until moved with rekey.
  local root; root=$(project_root "${1:-$PWD}")
  rm -f "$root/$PIN_FILE"
  printf 'key of %s is now %s\n' "$root" "$(project_key "$root")"
}

cmd_projects() {
  # Keys that have memory. A key is also the repo's address, for cloning on a new machine.
  [[ -d "$HOME_DIR/projects" ]] || return 0
  find "$HOME_DIR/projects" -type f \( -name 'SESSION.md' -o -name 'CORE.md' -o -name 'project.md' -o -path '*/imported/*' -o -path '*/_tasks/*' \) \
    | grep -vE '/superseded/' \
    | sed "s#^$HOME_DIR/projects/##" | sed -E -e 's#/imported/.*##' -e t -e 's#/_tasks/.*##' -e t -e 's#/[^/]+$##' | sort -u
}

cmd_search() {
  # search [--here] <query>. Two parts, shown apart because their rankings don't compare:
  # this user's own memory, through the chain of local providers, and what other members
  # of a connected hub wrote, through the hub's search or, failing that, its clone.
  # A provider that fails hands over to the next one; one that finds nothing does not.
  local here="" p rc
  [[ "${1:-}" == --here ]] && { here=--here; shift; }
  [[ $# -gt 0 ]] || die "usage: search [--here] <query>"
  for p in ${SEARCH_PROVIDERS:-qmd plain}; do
    rc=0
    case "$p" in
      qmd) search_qmd $here "$@" || rc=$? ;;
      plain) search_plain $here "$@" || rc=$? ;;
      *) search_command "$p" "$here" "$@" || rc=$? ;;
    esac
    [[ $rc -eq 0 ]] && break
  done
  search_hubs "$here" "$@"
}

search_qmd() {
  # BM25 through qmd. qmd has no path filter (it silently ignores --filter), so --here
  # filters its ranked file list. qmd also rewrites paths, turning dots into dashes, and
  # the key has to be compared in that form.
  command -v qmd >/dev/null 2>&1 || return 1
  if [[ "${1:-}" == --here ]]; then
    shift
    local prefix out
    prefix="qmd://memory-3layer/projects/$(project_key | tr '.' '-' | tr '[:upper:]' '[:lower:]')/"
    out=$(qmd search "$*" -c memory-3layer --files -n 200) || return 1
    printf '%s\n' "$out" | awk -F, -v p="$prefix" 'index($3, p) == 1' | head -n 10
  else
    qmd search "$*" -c memory-3layer -n 5
  fi
}

search_command() {
  # search_command <name> <--here or nothing> <query...>: a provider of the user's own,
  # SEARCH_CMD_<name> in the config. It gets the query as arguments and the directory to
  # search in MEMORY_3LAYER_SEARCH_DIR, and prints path:line<TAB>snippet per result.
  local name=$1 here=$2 var cmd dir="$HOME_DIR"; shift 2
  [[ "$name" =~ ^[A-Za-z0-9_]+$ ]] || { echo "search: bad provider name '$name'" >&2; return 1; }
  var="SEARCH_CMD_$name"; cmd=${!var:-}
  [[ -n "$cmd" ]] || { echo "search: provider '$name' has no $var in $CONFIG_FILE" >&2; return 1; }
  [[ -z "$here" ]] || dir="$HOME_DIR/projects/$(project_key)"
  MEMORY_3LAYER_SEARCH_DIR="$dir" bash -c "$cmd \"\$@\"" search "$@"
}

plain_files() {
  # plain_files <n> <directory> <a directory name to skip> <words...>: files that hold
  # the most of the words, then the most matching lines.
  local n=$1 dir=$2 skip=$3 w; shift 3
  local -a args=(); for w in "$@"; do args+=(-e "$w"); done
  for w in "$@"; do grep -rilF --include='*.md' --exclude-dir=superseded --exclude-dir=.git --exclude-dir='*.files' --exclude-dir="$skip" -- "$w" "$dir" 2>/dev/null; done \
    | sort | uniq -c | sort -rn | awk '{ $1 = $1 } 1' | while read -r cnt f; do
        printf '%d\t%d\t%s\n' "$cnt" "$(grep -ciF "${args[@]}" -- "$f")" "$f"
      done | sort -t$'\t' -k1,1nr -k2,2nr | head -n "$n" | cut -f3
}

plain_lines() {
  # plain_lines <words...>: for each file on stdin, its name and its first matching lines.
  local w f; local -a args=(); for w in "$@"; do args+=(-e "$w"); done
  while IFS= read -r f; do
    echo "== $f"
    grep -niF "${args[@]}" -- "$f" | head -n 3 | cut -c1-300
  done
}

search_plain() {
  # Without qmd: plain text. Archives are found only by search, so no qmd must not mean
  # no search.
  local here=0 dir="$HOME_DIR" n=5
  [[ "${1:-}" == --here ]] && { here=1; shift; dir="$HOME_DIR/projects/$(project_key)"; n=10; }
  [[ -d "$dir" ]] || return 0
  echo "qmd is not installed: plain-text search, files with the most of the words first." >&2
  local -a words; read -ra words <<< "$*"
  local files
  files=$(plain_files "$n" "$dir" superseded "${words[@]}")
  [[ -n "$files" ]] || { echo "nothing found" >&2; return 0; }
  if (( here )); then printf '%s\n' "$files"; return 0; fi
  plain_lines "${words[@]}" <<< "$files"
}

url_host() { printf '%s' "$1" | sed -nE 's#^[a-zA-Z][a-zA-Z0-9+.-]*://([^/@]*@)?([^/]+).*#\2#p'; }

hub_query() {
  # hub_query <search address> <secret name> <key or nothing> <own login> <clone> <query>:
  # ask the hub. Prints results of other members and succeeds, or fails for the fallback.
  # The token goes only to the host the hub's repository is on, checked by the caller.
  local url=$1 secret=$2 key=$3 me=$4 clone=$5 q=$6 body out code
  command -v curl >/dev/null && command -v python3 >/dev/null || return 1
  body="{\"query\":\"$(json_escape "$q")\",\"projects\":[${key:+\"$(json_escape "$key")\"}],\"limit\":20}"
  out=$(MEMORY_3LAYER_HOME="$HOME_DIR" MEMORY_3LAYER_SECRETS="$SECRETS_DIR" bash "$SELF_DIR/memory-secrets.sh" run "MEMORY_3LAYER_HUB_TOKEN=$secret" -- \
    bash -c 'curl -sS --max-time 20 -w "\n%{http_code}" -X POST "$1" -H "Authorization: Bearer $MEMORY_3LAYER_HUB_TOKEN" -H "Content-Type: application/json" -d "$2"' _ "$url" "$body" 2>/dev/null) || return 1
  code=${out##*$'\n'}; out=${out%$'\n'*}
  case "$code" in
    200) ;;
    401) echo "search: the hub rejected the token of secret://$secret: it is wrong or expired. Tell the user to renew it." >&2; return 1 ;;
    400|403) echo "search: the hub answered $code: $(printf '%s' "$out" | cut -c1-200). Tell the user." >&2; return 1 ;;
    *) return 1 ;;
  esac
  printf '%s' "$out" | python3 -c '
import json, sys
me, clone = sys.argv[1], sys.argv[2]
try:
    data = json.load(sys.stdin)
    rows = data.get("results", [])
except Exception:
    sys.exit(1)
print("#indexed %s" % (data.get("indexed") or "-"))
for r in rows:
    if r.get("login") == me:
        continue
    snip = " ".join(str(r.get("snippet", "")).split())[:300]
    print("%s/%s:%s\t[%s] %s" % (clone, r.get("path", ""), r.get("line", 1), r.get("login", "?"), snip))
' "$me" "$clone"
}

search_hubs() {
  # What other members of the connected hubs wrote. With --here, only the hub that holds
  # this project, and only this project in it.
  local here=$1 key="" addr clone login url secret out dir why idx base; shift
  local -a words; read -ra words <<< "$*"
  [[ -f "$(dirname "$CONFIG_FILE")/storage.conf" ]] || return 0
  [[ -z "$here" ]] || key=$(project_key)
  while IFS=$'\t' read -r addr clone login url secret; do
    [[ -n "$clone" ]] || continue
    dir="$clone/projects${key:+/$key}"
    # Nobody else in scope: nothing to add to the user's own memory.
    compgen -G "$dir/@*" >/dev/null || [[ -z "$key" ]] || continue
    out=""; why="its search did not answer"
    [[ "$url" != - ]] || why="it has no search of its own"
    # For a hub whose README does not name its search yet.
    [[ -z "${MEMORY_3LAYER_SEARCH_URL:-}" ]] || url=$MEMORY_3LAYER_SEARCH_URL
    if [[ "$url" != - && "$secret" != - && "$(url_host "$url")" == "$(url_host "$addr")" ]] \
       && out=$(hub_query "$url" "$secret" "$key" "$login" "$clone" "$*"); then
      # The index is built after a push, in the background: say when it lags behind.
      idx=${out%%$'\n'*}; idx=${idx#"#indexed "}; out=$(printf '%s\n' "$out" | sed 1d)
      base=$(cat "$clone.base" 2>/dev/null)
      if [[ -n "$base" && "$idx" != - ]] && git -C "$clone" cat-file -e "$idx^{commit}" 2>/dev/null \
         && ! git -C "$clone" merge-base --is-ancestor "$base" "$idx" 2>/dev/null; then
        echo "search: the hub has not indexed the latest push yet; its answer is from before it." >&2
      fi
      [[ -n "$out" ]] || continue
      printf '\n== other members, hub %s\n%s\n' "$addr" "$out"
    else
      [[ -d "$dir" ]] || continue
      out=$(plain_files 5 "$dir" "@$login" "${words[@]}")
      [[ -n "$out" ]] || continue
      printf '\n== other members, hub %s (%s: plain text over the local copy)\n' "$addr" "$why"
      plain_lines "${words[@]}" <<< "$out"
    fi
  done < <(MEMORY_3LAYER_HOME="$HOME_DIR" MEMORY_3LAYER_STATE="$STATE_DIR" MEMORY_3LAYER_CONFIG_DIR="$(dirname "$CONFIG_FILE")" MEMORY_3LAYER_SECRETS="$SECRETS_DIR" \
             bash "$SELF_DIR/memory-sync.sh" hubs ${key:+"$key"} 2>/dev/null </dev/null)
  return 0
}

cmd_refresh() {
  # Rebuild the search index. Vectors stay manual: `qmd embed` takes minutes of CPU.
  # --debounce is the session-start form: at most every 6 hours, silent without qmd.
  local marker="$STATE_DIR/last-refresh" last=0
  mkdir -p "$STATE_DIR"
  if [[ "${1:-}" == --debounce ]]; then
    [[ -f "$marker" ]] && last=$(cat "$marker" 2>/dev/null || echo 0)
    [[ $(( $(date +%s) - last )) -lt 21600 ]] && return 0
  fi
  command -v qmd >/dev/null 2>&1 || { [[ "${1:-}" == --debounce ]] && return 0; die "qmd is not installed"; }
  # The collection is global to the user, so moving the data dir must re-point it.
  local indexed
  indexed=$(qmd collection show memory-3layer 2>/dev/null | sed -nE 's/^[[:space:]]*Path:[[:space:]]*//p')
  if [[ -d "$HOME_DIR" && "$indexed" != "$HOME_DIR" ]]; then
    [[ -n "$indexed" ]] && qmd collection remove memory-3layer >> "$STATE_DIR/qmd-refresh.log" 2>&1
    qmd collection add "$HOME_DIR" --name memory-3layer >> "$STATE_DIR/qmd-refresh.log" 2>&1 || true
  fi
  qmd update >> "$STATE_DIR/qmd-refresh.log" 2>&1 && date +%s > "$marker"
}

usage() {
  cat <<'USAGE'
memory-3layer — agent memory that belongs to no harness

  path [home|secrets|config|state|identity|project] where things live (default: project)
  key [dir]                                     the project's stable key
  context [--hook-format hook|text]             what an agent must read at session start
  sync [--pull] [--quiet] [--allow-deletes]     sync with the configured storages
  sync tick [seconds]                           sync in the background if memory changed; for hooks
  sync init <address> | status | check | route [key]
                                                set the default storage, see state, test access, see routing
  install-cli [dir]                             make memory-3layer work in a terminal (~/.local/bin)
  migrate <harness> [--apply]                   copy data of an older version; plan only by default
  import <harness> [--apply]                    copy a harness's own memory here; plan only by default
  pin <key> [dir] / unpin [dir]                 fix a project's key, or go back to remote, then path
  rekey <old key> <new key>                     move memory after a remote changed
  projects                                      keys that have memory
  assign <old folder> <key>                     give an unattributed folder its project
  search [--here] <query>                       search own memory, and other members' in a hub
  refresh [--debounce]                          rebuild the search index
  guard                                         PreToolUse hook: block secrets, allow the data dir
  secret <command>                              local secret store: put, list, run, scan...
  hub init|upgrade <clone dir> | add <name> <remote> --login <login> | contact rm <clone dir> <login>   memory hubs: docs/hub.md
  task open|log|resume|show|files|list|close|redact   task journals; open, log and close take text on stdin: docs/tasks.md
  state                                         active and recently closed tasks (same as task list)
  core init | stash <title> | brief             CORE.md: put a project on it, archive a part, see the brief
USAGE
}

cmd=${1:-}; [[ $# -gt 0 ]] && shift
case "$cmd" in
  path)
    case "${1:-project}" in
      home) printf '%s\n' "$HOME_DIR" ;;
      secrets) printf '%s\n' "$SECRETS_DIR" ;;
      config) printf '%s\n' "$CONFIG_FILE" ;;
      state) printf '%s\n' "$STATE_DIR" ;;
      identity) identity_file; echo ;;
      project) project_dir "${2:-$PWD}"; echo ;;
      *) die "unknown path '$1'" ;;
    esac ;;
  key) project_key "${1:-$PWD}"; echo ;;
  task|core|state) tasks "$cmd" "$@" ;;
  context) cmd_context "$@" ;;
  sync)
    if [[ "${1:-}" == tick ]]; then
      MEMORY_3LAYER_HOME="$HOME_DIR" MEMORY_3LAYER_STATE="$STATE_DIR" MEMORY_3LAYER_CONFIG_DIR="$(dirname "$CONFIG_FILE")" MEMORY_3LAYER_SECRETS="$SECRETS_DIR" bash "$SELF_DIR/memory-sync.sh" "$@" </dev/null
      rc=$?; core_changed && tasks core log >/dev/null 2>&1
      cmd_tick_notes; exit $rc
    fi
    MEMORY_3LAYER_HOME="$HOME_DIR" MEMORY_3LAYER_STATE="$STATE_DIR" MEMORY_3LAYER_CONFIG_DIR="$(dirname "$CONFIG_FILE")" MEMORY_3LAYER_SECRETS="$SECRETS_DIR" exec bash "$SELF_DIR/memory-sync.sh" "$@" ;;
  hub) MEMORY_3LAYER_HOME="$HOME_DIR" MEMORY_3LAYER_CONFIG_DIR="$(dirname "$CONFIG_FILE")" MEMORY_3LAYER_SECRETS="$SECRETS_DIR" exec bash "$SELF_DIR/memory-hub.sh" "$@" ;;
  install-cli) cmd_install_cli "$@" ;;
  migrate)
    if (( BASH_VERSINFO[0] < 4 )); then
      b=$(bash4) || die "migrate needs bash 4 or newer. On macOS: brew install bash"
      exec "$b" "${BASH_SOURCE[0]}" migrate "$@"
    fi
    cmd_migrate "$@" ;;
  import) cmd_import "$@" ;;
  pin) cmd_pin "$@" ;;
  unpin) cmd_unpin "$@" ;;
  rekey) cmd_rekey "$@" ;;
  projects) cmd_projects ;;
  assign) cmd_assign "$@" ;;
  search) cmd_search "$@" ;;
  refresh) cmd_refresh "$@" ;;
  guard) MEMORY_3LAYER_HOME="$HOME_DIR" MEMORY_3LAYER_SECRETS="$SECRETS_DIR" exec bash "$SELF_DIR/memory-secrets.sh" guard ;;
  secret) MEMORY_3LAYER_HOME="$HOME_DIR" MEMORY_3LAYER_SECRETS="$SECRETS_DIR" exec bash "$SELF_DIR/memory-secrets.sh" "$@" ;;
  ''|-h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
